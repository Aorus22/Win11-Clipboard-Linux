[Desktop Entry]
Version=1.0
Type=Application
Name=Clipboard History (GPUI)
GenericName=Clipboard Manager
Comment=Windows 11-style clipboard history manager for Linux (GPUI native build)
Exec=__BINDIR__/win11-clipboard-history-gpui
Icon=win11-clipboard-history-gpui
Terminal=false
Categories=Utility;
StartupNotify=false
Actions=Settings;

[Desktop Action Settings]
Name=Open Clipboard Settings
Exec=__BINDIR__/win11-clipboard-history-gpui --settings-open
