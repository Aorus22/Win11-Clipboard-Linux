# syntax=docker/dockerfile:1

# Win11 Clipboard — AppImage BUILD environment (Linux x86_64, GPUI only).
#
# This image carries the toolchain + system headers ONLY; the source tree is
# never copied in. Callers mount the repo at /src and run the repo's own build
# script, so the same image serves CI and a local one-off:
#
#   docker build -f docker/Dockerfile.build -t winclip-build .
#   docker run --rm -v "$PWD:/src" -w /src winclip-build \
#     bash docker/build-appimage.sh
#
# Result: the GPUI AppImage in the host tree, plus checksums — see
# docker/README.md. GitHub Actions does exactly this
# (.github/workflows/build-appimage.yml).
#
# Base is Debian bookworm on purpose: its glibc (2.36) is OLDER than the target
# desktops' (Fedora/Ubuntu), which is the safe direction for a portable
# AppImage — the binary only needs symbols that already existed at build time.

FROM rust:1-slim-bookworm AS build

ARG DEBIAN_FRONTEND=noninteractive
# Bumped here, not in the repo script: the GPUI script honours these two env
# vars, so pinning the URLs in one place keeps the tool versions reproducible.
ARG LINUXDEPLOY_URL=https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage
ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage

# System build deps, in two groups:
#   1. toolchain plumbing — pkg-config drives every `-sys` crate.
#   2. GPUI window/GL/font stack — the GTK3 dev headers (the GPUI client links
#      the `gtk` crate for the tray backend), fontconfig + freetype for text,
#      and the X11/Wayland/Vulkan headers gpui links against. libxdo headers
#      cover paste simulation, ayatana-appindicator the tray icon.
# `squashfs-tools` is not optional: scripts/build-gpui-appimage.sh pre-flights
# `mksquashfs` before it does any work.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates curl wget file \
      libssl-dev \
      libayatana-appindicator3-dev librsvg2-dev libxdo-dev \
      libgtk-3-dev libglib2.0-dev \
      libfontconfig1-dev libfreetype-dev \
      libx11-dev libxcb1-dev libxkbcommon-dev libxkbcommon-x11-dev \
      libwayland-dev libvulkan-dev \
      clang libclang-dev \
      squashfs-tools \
 && rm -rf /var/lib/apt/lists/*

# sccache — compiler cache so rebuilds skip unchanged crates. Installed via
# cargo (slow once, then cached as an image layer by CI's GHA layer cache).
# The cache directory itself is mounted from the host at run time and persisted
# across CI runs by actions/cache (see the workflow); RUSTC_WRAPPER is exported
# by docker/build-appimage.sh so both cargo invocations share it.
RUN cargo install sccache --locked \
 && rm -rf /usr/local/cargo/registry \
 && sccache --version

ENV SCCACHE_CACHE_SIZE=2G \
    SCCACHE_DIR=/root/.cache/sccache

# Pin the two AppImage helpers into the image instead of letting the build fetch
# them from GitHub mid-run. The GPUI repo script downloads through
# LINUXDEPLOY_URL / APPIMAGETOOL_URL and runs each tool with
# `--appimage-extract-and-run` (no FUSE in containers), so a `file://` URL is
# all it takes to swap in these copies.
# The `--version` calls below fail the image build if a tool cannot execute
# headless, which is where a broken CI run would otherwise show up 20 minutes in.
RUN curl -fsSL -o /opt/linuxdeploy-x86_64.AppImage "${LINUXDEPLOY_URL}" \
 && curl -fsSL -o /opt/appimagetool-x86_64.AppImage "${APPIMAGETOOL_URL}" \
 && chmod +x /opt/linuxdeploy-x86_64.AppImage /opt/appimagetool-x86_64.AppImage \
 && /opt/linuxdeploy-x86_64.AppImage --appimage-extract-and-run --version \
 && /opt/appimagetool-x86_64.AppImage --appimage-extract-and-run --version

ENV LINUXDEPLOY_URL=file:///opt/linuxdeploy-x86_64.AppImage \
    APPIMAGETOOL_URL=file:///opt/appimagetool-x86_64.AppImage

RUN cargo --version

WORKDIR /src
